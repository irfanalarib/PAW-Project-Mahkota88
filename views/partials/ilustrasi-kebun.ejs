<%# Ilustrasi dedaunan dan buah kopi (SVG) untuk bagian Cerita. %>
<svg viewBox="0 0 400 300" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <g fill="#14532D" opacity=".7">
    <% for (var i = 0; i < 10; i++) {
         var cx = 30 + i * 40; var cy = 50 + (i % 3) * 80; %>
      <ellipse cx="<%= cx %>" cy="<%= cy %>" rx="48" ry="16" transform="rotate(<%= -35 + i * 13 %> <%= cx %> <%= cy %>)"/>
    <% } %>
  </g>
  <g fill="#B91C1C">
    <% [[90,120],[130,150],[170,110],[230,160],[270,125],[310,170],[200,210],[110,220],[290,230],[340,110],[60,190],[245,80]].forEach(function (c) { %>
      <circle cx="<%= c[0] %>" cy="<%= c[1] %>" r="9"/>
    <% }); %>
  </g>
  <g fill="#FCA5A5" opacity=".5">
    <% [[87,117],[127,147],[167,107],[227,157]].forEach(function (c) { %>
      <circle cx="<%= c[0] %>" cy="<%= c[1] %>" r="3"/>
    <% }); %>
  </g>
</svg>