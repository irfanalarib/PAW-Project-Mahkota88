  <script>
    // Menu mobile
    (function () {
      var btn = document.getElementById('menu-btn');
      var menu = document.getElementById('menu-mobile');
      if (!btn || !menu) return;
      btn.addEventListener('click', function () {
        var terbuka = menu.classList.toggle('hidden') === false;
