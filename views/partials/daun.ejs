<%# Ilustrasi garis ranting dan daun (SVG dekoratif). Pemakaian: include('partials/daun', { kelas: '...' }) %>
<svg viewBox="0 0 140 140" class="<%= kelas %>" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" aria-hidden="true">
  <path d="M8 132 Q60 96 124 14"/>
  <% for (var i = 1; i <= 7; i++) {
       var t = i / 8;
       var x = (1 - t) * (1 - t) * 8 + 2 * (1 - t) * t * 60 + t * t * 124;
       var y = (1 - t) * (1 - t) * 132 + 2 * (1 - t) * t * 96 + t * t * 14;
       var dx = 2 * (1 - t) * (60 - 8) + 2 * t * (124 - 60);
       var dy = 2 * (1 - t) * (96 - 132) + 2 * t * (14 - 96);
       var sudut = Math.atan2(dy, dx) * 180 / Math.PI;
       var sisi = i % 2 === 0 ? 55 : -55; %>
    <g transform="translate(<%= x.toFixed(1) %> <%= y.toFixed(1) %>) rotate(<%= (sudut + sisi).toFixed(1) %>)">
      <path d="M0 0 Q14 -9 28 0 Q14 9 0 0Z"/>
      <path d="M0 0 L26 0"/>
    </g>
  <% } %>
</svg>