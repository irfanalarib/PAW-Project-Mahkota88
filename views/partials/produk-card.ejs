<%# Kartu produk. Pemakaian: include('partials/produk-card', { p: p }) %>
<article class="flex h-full flex-col rounded-3xl bg-ivory p-4 text-center shadow-sm ring-1 ring-brown/5 transition hover:shadow-md">
  <div class="relative flex h-52 items-center justify-center rounded-2xl bg-beige/50">
    <% if (p.gambar) { %>
      <img src="<%= p.gambar %>" alt="Kemasan kopi <%= p.nama %>" loading="lazy" class="h-44 w-auto object-contain">
    <% } else { %>
      <%- include('kemasan', { nama: p.nama, asal: p.asal, berat: p.berat, kelas: 'h-44 w-auto' }) %>
    <% } %>
    <span class="absolute right-3 top-3 rounded-full px-2.5 py-0.5 text-[11px] font-medium <%= p.tersedia ? 'bg-sage/15 text-sage' : 'bg-red-100 text-red-800' %>">
      <%= p.tersedia ? 'Tersedia' : 'Habis' %>
    </span>
  </div>

  <h3 class="mt-4 font-serif text-lg font-bold text-brown"><%= p.nama %></h3>
  <% if (p.asal) { %><p class="text-xs text-sage"><%= p.asal %></p><% } %>
  <p class="mt-1 text-xs text-brown/60">
    <%= p.roast ? 'Roast ' + p.roast : '' %><%= (p.roast && p.berat) ? ' · ' : '' %><%= p.berat ? 'Beans ' + p.berat : '' %>
  </p>
  <% if (p.notes && p.notes.length) { %>
    <p class="mt-2 text-xs italic text-brown/60"><%= p.notes.join(' · ') %></p>
  <% } %>
  <p class="mt-auto pt-4 text-base font-semibold text-brown"><%= formatRupiah(p.harga) %></p>
</article>