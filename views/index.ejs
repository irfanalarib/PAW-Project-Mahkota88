<%- include('partials/header', { title: title }) %>

<main>
  <%# ===== 1. HERO ===== %>
  <section class="bg-gradient-to-b from-cream/70 to-ivory" aria-labelledby="judul-hero">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-14 md:grid-cols-2 md:py-20">
      <div>
        <span class="inline-block border border-gold px-2 py-0.5 text-[11px] uppercase tracking-widest text-coffee">Kopi Nusantara</span>
        <h1 id="judul-hero" class="mt-5 font-serif text-4xl font-bold leading-tight sm:text-5xl">Cita Rasa Lokal,<br>Kualitas Istimewa.</h1>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-brown/80 sm:text-base"><%= config.tagline %></p>
        <a href="#katalog" class="mt-8 inline-flex items-center gap-2 bg-brown px-6 py-3 text-xs font-medium uppercase tracking-widest text-cream hover:bg-coffee">
          Belanja Sekarang <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="relative h-72 overflow-hidden rounded-3xl bg-gradient-to-br from-cream to-gold/60 sm:h-96">
        <%- include('partials/biji-hero') %>
      </div>
    </div>
  </section>

  <%# ===== 2. PITA HARGA TETAP ===== %>
  <section class="bg-brown text-cream" aria-label="Informasi harga">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-8 px-4 py-8 sm:justify-between">
      <div class="flex items-end -space-x-4" aria-hidden="true">
        <%- include('partials/kemasan', { nama: 'Mahkota', kelas: 'h-28 w-auto' }) %>
        <%- include('partials/kemasan', { nama: 'Nusantara', kelas: 'h-32 w-auto' }) %>
        <%- include('partials/kemasan', { nama: 'Pilihan', kelas: 'h-28 w-auto' }) %>
      </div>
      <div class="max-w-md text-center sm:text-left">
        <p class="font-serif text-3xl font-bold text-gold">Harga Tetap</p>
        <p class="mt-1 text-sm text-cream/80">Harga yang tertera adalah harga resmi toko, tanpa biaya tersembunyi. Pesan tanpa daftar akun dan selesaikan lewat WhatsApp.</p>
      </div>
    </div>
  </section>

  <%# ===== 3. KATALOG ===== %>
  <section id="katalog" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16" aria-labelledby="judul-katalog">
    <div class="flex items-center gap-4">
      <span class="h-px flex-1 bg-brown/20"></span>
      <h2 id="judul-katalog" class="font-serif text-2xl font-bold sm:text-3xl">Katalog Kopi</h2>
      <span class="h-px flex-1 bg-brown/20"></span>
    </div>
    <p class="mt-3 text-center text-sm text-brown/70"><%= totalTersedia %> dari <%= totalProduk %> varian tersedia</p>

    <% if (produk.length === 0) { %>
      <p class="mt-10 text-center text-brown/60">Belum ada produk. Tambahkan lewat halaman Kelola.</p>
    <% } else { %>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% produk.forEach(function (p) { %>
          <%- include('partials/produk-card', { p: p }) %>
        <% }); %>
      </div>
    <% } %>
  </section>

  <%# ===== 4. CERITA ASAL KOPI ===== %>
  <section id="cerita" class="scroll-mt-20 bg-cream/60" aria-labelledby="judul-cerita">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-14 md:grid-cols-2">
      <div class="relative h-64 overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-900 to-brown md:h-80">
        <%- include('partials/ilustrasi-kebun') %>
      </div>
      <div>
        <span class="inline-block border border-gold px-2 py-0.5 text-[11px] uppercase tracking-widest text-coffee">Cerita Kami</span>
        <h2 id="judul-cerita" class="mt-4 font-serif text-3xl font-bold">Kopi dari Tanah Pilihan</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-brown/80">
          Dapatkan pengalaman rasa kopi khas daerah dari perkebunan terbaik di Indonesia.
          Setiap varian di katalog dilengkapi daerah asal, tingkat sangrai, dan profil rasa.
        </p>
        <a href="#katalog" class="mt-5 inline-block border-b border-brown text-sm font-medium hover:text-gold hover:border-gold">Selengkapnya &rarr;</a>
      </div>
    </div>
  </section>

  <%# ===== 5. KUALITAS ===== %>
  <section id="kualitas" class="scroll-mt-20 bg-brown text-cream"
    style="background-image: repeating-linear-gradient(45deg, rgba(255,255,255,.04) 0 6px, transparent 6px 12px);"
    aria-labelledby="judul-kualitas">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center md:text-left">
      <h2 id="judul-kualitas" class="font-serif text-3xl font-bold">Kualitas Terbaik<br>di Setiap Kemasan</h2>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-cream/80 md:max-w-lg">
        Melalui proses seleksi yang ketat, kami menghadirkan kopi berkualitas untuk Anda.
      </p>
      <a href="#katalog" class="mt-6 inline-flex items-center gap-2 border border-gold px-5 py-2.5 text-xs font-medium uppercase tracking-widest text-gold hover:bg-gold hover:text-brown">Lihat Katalog</a>
    </div>
  </section>

  <%# ===== 6. MENGAPA MEMILIH KAMI ===== %>
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="judul-mengapa">
    <h2 id="judul-mengapa" class="text-center font-serif text-2xl font-bold sm:text-3xl">Mengapa <%= config.appName %>?</h2>

    <div class="mt-10 grid gap-8 text-center sm:grid-cols-3">
      <div>
        <svg class="mx-auto h-10 w-10 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14z"/><path d="M5 19L13 11"/></svg>
        <h3 class="mt-3 text-sm font-semibold">Kopi Pilihan</h3>
        <p class="mt-1 text-sm text-brown/70">dari Tanah Indonesia</p>
      </div>
      <div>
        <svg class="mx-auto h-10 w-10 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8l8-4 8 4v8l-8 4-8-4V8z"/><path d="M4 8l8 4 8-4M12 12v8"/></svg>
        <h3 class="mt-3 text-sm font-semibold">Kemasan Berkualitas</h3>
        <p class="mt-1 text-sm text-brown/70">&amp; Praktis</p>
      </div>
      <div>
        <svg class="mx-auto h-10 w-10 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9h11v4a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9z"/><path d="M16 10h2a2 2 0 0 1 0 4h-2"/><path d="M8 4v2M12 4v2"/></svg>
        <h3 class="mt-3 text-sm font-semibold">Rasa Autentik</h3>
        <p class="mt-1 text-sm text-brown/70">yang Khas</p>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>