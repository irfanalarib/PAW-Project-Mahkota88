<%- include('partials/header', { title: title }) %>

<main>
  <section class="bg-gradient-to-b from-stone-900 to-stone-800 text-stone-50">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl"><%= config.appName %></h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-stone-300"><%= config.tagline %></p>
      <p class="mt-6 inline-block rounded-full bg-amber-400/10 px-4 py-1 text-sm text-amber-300">
        <%= totalTersedia %> dari <%= produk.length %> varian tersedia
      </p>
    </div>
  </section>

  <section id="katalog" class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="judul-katalog">
    <h2 id="judul-katalog" class="text-2xl font-bold">Katalog Kopi</h2>
    <p class="mt-1 text-stone-600">Daftar varian beserta harga, profil rasa, dan status stok.</p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% produk.forEach(function (p) { %>
        <article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex h-32 items-center justify-center rounded-xl bg-amber-100 text-5xl" aria-hidden="true">&#9749;</div>

          <div class="mt-4 flex items-start justify-between gap-2">
            <h3 class="text-lg font-semibold"><%= p.nama %></h3>
            <% if (p.tersedia) { %>
              <span class="shrink-0 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800">Tersedia</span>
            <% } else { %>
              <span class="shrink-0 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">Habis</span>
            <% } %>
          </div>

          <p class="mt-1 text-sm text-stone-500"><%= p.jenis %> &middot; <%= p.asal %> &middot; Roast <%= p.roast %></p>

          <ul class="mt-3 flex flex-wrap gap-2" aria-label="Profil rasa">
            <% p.notes.forEach(function (n) { %>
              <li class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs text-stone-700"><%= n %></li>
            <% }); %>
          </ul>

          <p class="mt-4 text-xl font-bold text-amber-700">
            <%= formatRupiah(p.harga) %>
            <span class="text-sm font-normal text-stone-500">/ <%= p.berat %></span>
          </p>
        </article>
      <% }); %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
