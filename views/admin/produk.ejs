<%- include('../partials/header', { title: title }) %>
<% var inp = 'mt-1 w-full rounded-lg border border-brown/20 bg-white px-3 py-2 text-sm'; %>

<main class="mx-auto max-w-6xl px-4 py-12">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="font-serif text-2xl font-bold sm:text-3xl">Kelola Katalog</h1>
      <p class="mt-1 text-sm text-brown/70"><%= produk.length %> produk tersimpan di database.</p>
    </div>
    <button id="btn-tambah" type="button"
      class="bg-brown px-6 py-3 text-xs font-medium uppercase tracking-widest text-cream hover:bg-coffee">
      + Tambah Produk
    </button>
  </div>

  <p id="pesan-halaman" class="mt-4 hidden rounded-lg bg-red-100 px-4 py-3 text-sm text-red-800" role="alert"></p>

  <% if (produk.length === 0) { %>
    <p class="mt-10 rounded-xl border border-dashed border-brown/30 p-10 text-center text-brown/60">
      Belum ada data. Jalankan <code>npm run seed</code> atau tambahkan produk baru.
    </p>
  <% } else { %>
    <div class="mt-8 overflow-x-auto rounded-2xl border border-brown/10 bg-white">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-cream text-xs uppercase tracking-widest text-coffee">
          <tr>
            <th class="px-4 py-3">ID</th>
            <th class="px-4 py-3">Nama</th>
            <th class="px-4 py-3">Asal</th>
            <th class="px-4 py-3">Roast</th>
            <th class="px-4 py-3">Harga</th>
            <th class="px-4 py-3">Stok</th>
            <th class="px-4 py-3 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brown/10">
          <% produk.forEach(function (p) { %>
            <tr>
              <td class="px-4 py-3 text-brown/50"><%= p.id %></td>
              <td class="px-4 py-3 font-medium"><%= p.nama %></td>
              <td class="px-4 py-3"><%= p.asal || '-' %></td>
              <td class="px-4 py-3"><%= p.roast || '-' %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= formatRupiah(p.harga) %></td>
              <td class="px-4 py-3">
                <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold <%= p.stok > 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800' %>"><%= p.stok %></span>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-right">
                <button type="button" data-aksi="ubah" data-produk="<%= JSON.stringify(p) %>"
                  class="rounded-lg border border-brown/20 px-3 py-1.5 text-xs font-semibold hover:bg-cream">Ubah</button>
                <button type="button" data-aksi="hapus" data-id="<%= p.id %>" data-nama="<%= p.nama %>"
                  class="ml-1 rounded-lg border border-red-300 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50">Hapus</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%# ===== Dialog form tambah / ubah ===== %>
<dialog id="dialog-produk" class="w-full max-w-lg rounded-2xl p-0 backdrop:bg-black/50">
  <form id="form-produk" class="p-6" novalidate>
    <h2 id="judul-form" class="font-serif text-xl font-bold">Tambah Produk</h2>
    <p id="error-form" class="mt-3 hidden rounded-lg bg-red-100 px-3 py-2 text-sm text-red-800" role="alert"></p>

    <input type="hidden" name="produk_id">

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="text-sm font-medium sm:col-span-2">Nama produk
        <input name="nama" type="text" maxlength="120" class="<%= inp %>">
      </label>

      <label class="text-sm font-medium">Asal
        <input name="asal" type="text" maxlength="80" placeholder="Aceh Tengah" class="<%= inp %>">
      </label>

      <label class="text-sm font-medium">Roast
        <select name="roast" class="<%= inp %>">
          <option value="Light">Light</option>
          <option value="Medium" selected>Medium</option>
          <option value="Medium-Dark">Medium-Dark</option>
          <option value="Dark">Dark</option>
        </select>
      </label>

      <label class="text-sm font-medium">Berat / ukuran
        <input name="berat" type="text" maxlength="30" placeholder="200 gr" class="<%= inp %>">
      </label>

      <label class="text-sm font-medium">Harga (Rp)
        <input name="harga" type="number" min="0" step="1" class="<%= inp %>">
      </label>

      <label class="text-sm font-medium">Stok
        <input name="stok" type="number" min="0" step="1" value="0" class="<%= inp %>">
      </label>

      <label class="text-sm font-medium sm:col-span-2">Profil rasa (pisahkan dengan koma)
        <input name="notes" type="text" placeholder="Cokelat, Rempah, Body tebal" class="<%= inp %>">
      </label>

      <label class="text-sm font-medium sm:col-span-2">URL foto kemasan (opsional)
        <input name="gambar" type="text" maxlength="255" placeholder="https://... atau /images/gayo.jpg" class="<%= inp %>">
      </label>
    </div>

    <div class="mt-6 flex justify-end gap-2">
      <button type="button" id="btn-batal" class="border border-brown/20 px-5 py-2 text-xs font-medium uppercase tracking-widest hover:bg-cream">Batal</button>
      <button type="submit" id="btn-simpan" class="bg-gold px-6 py-2 text-xs font-semibold uppercase tracking-widest text-brown hover:opacity-90 disabled:opacity-50">Simpan</button>
    </div>
  </form>
</dialog>

<script>
  (function () {
    var dialog = document.getElementById('dialog-produk');
    var form = document.getElementById('form-produk');
    var judul = document.getElementById('judul-form');
    var errForm = document.getElementById('error-form');
    var pesanHalaman = document.getElementById('pesan-halaman');
    var tombolSimpan = document.getElementById('btn-simpan');
    var FIELD = ['nama', 'asal', 'roast', 'berat', 'harga', 'stok', 'gambar'];

    function tampilkan(el, teks) {
      el.textContent = teks;
      el.classList.remove('hidden');
    }

    function teksError(hasil) {
      var daftar = [hasil.pesan || 'Terjadi kesalahan'].concat(hasil.detail || []);
      return daftar.join(' - ');
    }

    function bukaTambah() {
      form.reset();
      form.elements.produk_id.value = '';
      judul.textContent = 'Tambah Produk';
      errForm.classList.add('hidden');
      dialog.showModal();
    }

    function bukaUbah(p) {
      form.reset();
      form.elements.produk_id.value = p.id;
      FIELD.forEach(function (k) {
        form.elements[k].value = p[k] == null ? '' : p[k];
      });
      form.elements.notes.value = (p.notes || []).join(', ');
      judul.textContent = 'Ubah Produk #' + p.id;
      errForm.classList.add('hidden');
      dialog.showModal();
    }

    document.getElementById('btn-tambah').addEventListener('click', bukaTambah);
    document.getElementById('btn-batal').addEventListener('click', function () { dialog.close(); });

    // Tombol Ubah / Hapus pada tabel (event delegation)
    document.addEventListener('click', async function (e) {
      var tombol = e.target.closest('[data-aksi]');
      if (!tombol) return;

      if (tombol.dataset.aksi === 'ubah') {
        bukaUbah(JSON.parse(tombol.dataset.produk));
        return;
      }

      if (tombol.dataset.aksi === 'hapus') {
        if (!confirm('Hapus produk "' + tombol.dataset.nama + '"?')) return;
        try {
          var res = await fetch('/api/produk/' + tombol.dataset.id, { method: 'DELETE' });
          var hasil = await res.json();
          if (!res.ok) return tampilkan(pesanHalaman, teksError(hasil));
          location.reload();
        } catch (err) {
          tampilkan(pesanHalaman, 'Tidak dapat terhubung ke server');
        }
      }
    });

    // Simpan (POST untuk baru, PUT untuk ubah)
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errForm.classList.add('hidden');

      var id = form.elements.produk_id.value;
      var payload = { notes: form.elements.notes.value };
      FIELD.forEach(function (k) { payload[k] = form.elements[k].value; });

      tombolSimpan.disabled = true;
      try {
        var res = await fetch(id ? '/api/produk/' + id : '/api/produk', {
          method: id ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var hasil = await res.json();
        if (!res.ok) {
          tampilkan(errForm, teksError(hasil));
          return;
        }
        location.reload(); // muat ulang agar tampil data terbaru dari database
      } catch (err) {
        tampilkan(errForm, 'Tidak dapat terhubung ke server');
      } finally {
        tombolSimpan.disabled = false;
      }
    });
  })();
</script>

<%- include('../partials/footer') %>